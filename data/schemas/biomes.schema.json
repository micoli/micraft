{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BiomeConfig",
  "type": "object",
  "required": ["biomes"],
  "additionalProperties": false,
  "properties": {
    "voronoiCellSize": {
      "type": "integer",
      "default": 256
    },
    "voronoiBlendRadius": {
      "type": "integer",
      "default": 16
    },
    "biomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/biomeDefinition" }
    }
  },
  "$defs": {
    "blockType": {
      "type": "string",
      "enum": ["AIR", "BEDROCK", "STONE", "DIRT", "GRASS", "SAND", "SANDSTONE", "GRAVEL", "SNOW",
               "OAK_LOG", "OAK_LEAVES", "PINE_LOG", "PINE_LEAVES", "PINE_LEAVES_SNOW", "FLOWER", "WEED"]
    },
    "biomeZone": {
      "type": "object",
      "required": ["moistureMin", "moistureMax"],
      "additionalProperties": false,
      "properties": {
        "moistureMin": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "moistureMax": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "altitudeMin": { "type": "integer" },
        "altitudeMax": { "type": "integer" }
      }
    },
    "vegetationEntry": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "density": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.0 }
      }
    },
    "biomeDefinition": {
      "type": "object",
      "required": ["id", "zones", "surface", "subsurface"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "zones": {
          "type": "array",
          "items": { "$ref": "#/$defs/biomeZone" }
        },
        "surface": { "$ref": "#/$defs/blockType" },
        "subsurface": { "$ref": "#/$defs/blockType" },
        "subsurfaceDepth": { "type": "integer", "default": 3 },
        "filler": { "$ref": "#/$defs/blockType" },
        "vegetation": {
          "type": "array",
          "items": { "$ref": "#/$defs/vegetationEntry" }
        },
        "elevationMin": { "type": "integer", "default": 40 },
        "elevationMax": { "type": "integer", "default": 120 },
        "grassColor": {
          "type": "array",
          "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "minItems": 3,
          "maxItems": 3,
          "description": "RGB grass tint [r, g, b] in [0, 1] range. Omit to use the client default."
        }
      }
    }
  }
}
