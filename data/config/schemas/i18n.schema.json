{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MiCraft i18n translation file",
  "description": "Maps feature → scope (server|client) → key → translation string. Use {0}, {1}, … for positional placeholders.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "description": "Feature group (e.g. commands, inventory, help)",
    "properties": {
      "server": {
        "type": "object",
        "description": "Server-side translation keys",
        "additionalProperties": { "type": "string" }
      },
      "client": {
        "type": "object",
        "description": "Client-side translation keys",
        "additionalProperties": { "type": "string" }
      }
    },
    "additionalProperties": false
  }
}
