# Supply-chain hardening for the app TS package.
# New deps are pinned to an exact version so a lockfile diff is always explicit.
save-exact=true
fund=false
audit=true

# Install scripts are NOT globally disabled here: esbuild / @swc/core / @parcel/watcher
# need their postinstall to fetch the platform binary. The `allowScripts` allow-list in
# package.json enumerates the packages permitted to run scripts — enforce it with
# `npx @lavamoat/allow-scripts` once that dev dependency is added, then flip this to true.
# ignore-scripts=true
