{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thresholds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commonPerLevel": {
          "type": "integer"
        },
        "elitePerLevel": {
          "type": "integer"
        },
        "bossPerLevel": {
          "type": "integer"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bonusPerMember": {
          "type": "number"
        }
      }
    }
  }
}
