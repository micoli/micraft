{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["state"],
  "additionalProperties": false,
  "properties": {
    "state": {
      "type": "object",
      "required": ["id", "name", "pos", "orientation"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "pos": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "z": {"type": "number"}
          },
          "additionalProperties": false
        },
        "orientation": {
          "type": "object",
          "required": ["yaw", "pitch"],
          "properties": {
            "yaw": {"type": "number"},
            "pitch": {"type": "number"}
          },
          "additionalProperties": false
        },
        "stance": {"type": "string", "enum": ["STANDING", "SNEAKING", "CRAWLING"]},
        "flying": {"type": "boolean"},
        "speedMultiplier": {"type": "number"},
        "biome": {"type": "string"},
        "inventory": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "language": {"type": "string"},
        "shadersEnabled": {"type": "boolean"},
        "shortcutBar": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "properties": {"type": {"type": "string"}}, "additionalProperties": true}
            ]
          }
        },
        "layouts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "widgets"],
            "properties": {
              "name": {"type": "string"},
              "widgets": {"type": "array", "items": {"type": "object"}}
            }
          }
        },
        "activeLayout": {"type": "string"},
        "subscribedChannels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string"},
              "autoFocus": {"type": "boolean"}
            }
          }
        },
        "disabledCommands": {
          "type": "array",
          "items": {"type": "string"}
        },
        "viewMode": {"type": "string", "enum": ["FIRST_PERSON", "FIRST_PERSON_NO_ARMS", "THIRD_PERSON"]},
        "skin": {"type": "string"},
        "armors": {"type": "array", "items": {"type": "string"}},
        "animatedFavicon": {"type": "boolean"},
        "chunkDebugVisible": {"type": "boolean"},
        "fieldOfView": {"type": "integer", "minimum": 1, "maximum": 180},
        "knownRecipes": {"type": "array", "items": {"type": "string"}},
        "characterData": {"type": ["object", "null"]},
        "rpgOptOut": {"type": "boolean"},
        "godMode": {"type": "boolean"},
        "lightBoostEnabled": {"type": "boolean"}
      }
    },
    "keybindings": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "customCommands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    }
  }
}
