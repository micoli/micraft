{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worldMinY": {
          "type": "integer"
        },
        "worldMaxY": {
          "type": "integer"
        },
        "chunkSize": {
          "type": "integer"
        },
        "viewRadius": {
          "type": "integer"
        },
        "forwardViewRadius": {
          "type": "integer"
        },
        "waterLevel": {
          "type": "integer"
        },
        "impostorSkirtDepth": {
          "type": "integer"
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heightStanding": {
          "type": "number"
        },
        "heightSneaking": {
          "type": "number"
        },
        "heightCrawling": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "eyeOffsetStanding": {
          "type": "number"
        },
        "eyeOffsetSneaking": {
          "type": "number"
        },
        "eyeOffsetCrawling": {
          "type": "number"
        },
        "speedStanding": {
          "type": "number"
        },
        "speedSneaking": {
          "type": "number"
        },
        "speedCrawling": {
          "type": "number"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "usersFile": {
              "type": "string"
            },
            "groupsFile": {
              "type": "string"
            }
          }
        },
        "oauth": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string"
                },
                "clientId": {
                  "type": "string"
                },
                "clientSecret": {
                  "type": "string"
                },
                "redirectUri": {
                  "type": "string"
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "chunks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "type": "string"
        },
        "httpWorkers": {
          "type": "integer"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messageEncoder": {
          "type": "string"
        }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tickMs": {
          "type": "integer"
        },
        "gravity": {
          "type": "number"
        },
        "jumpSpeed": {
          "type": "number"
        },
        "flyVerticalSpeed": {
          "type": "number"
        },
        "saveIntervalSeconds": {
          "type": "integer"
        },
        "spawnX": {
          "type": "number"
        },
        "spawnY": {
          "type": "number"
        },
        "spawnZ": {
          "type": "number"
        },
        "ticksPerDay": {
          "type": "integer"
        },
        "timeBroadcastTicks": {
          "type": "integer"
        },
        "maxInteractionDistance": {
          "type": "number"
        },
        "reconcileToleranceXz": {
          "type": "number"
        },
        "reconcileToleranceY": {
          "type": "number"
        },
        "blockBreakBufferSize": {
          "type": "integer"
        },
        "worldSeed": {
          "type": "integer"
        }
      }
    },
    "factions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "friendlyFire": {
          "type": "boolean"
        },
        "changeCooldownSeconds": {
          "type": "integer"
        },
        "list": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "minItems": 0,
          "maxItems": 5
        }
      }
    }
  }
}
