{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "TOKEN_RAGE_CONSUME",
        "NECROTIC_AOE"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "rageGain": {
      "type": "integer"
    },
    "tokenCost": {
      "type": "integer"
    },
    "manaCost": {
      "type": "integer"
    },
    "rageCost": {
      "type": "integer"
    },
    "cooldownMs": {
      "type": "integer"
    },
    "aoeRadius": {
      "type": "number"
    },
    "maxRange": {
      "type": "number"
    }
  }
}
