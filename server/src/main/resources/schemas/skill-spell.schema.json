{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "TOKEN_RAGE_CONSUME",
        "NECROTIC_AOE",
        "DIRECT_DAMAGE"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "ranks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rageGain": {
            "type": "integer"
          },
          "tokenCost": {
            "type": "integer"
          },
          "manaCost": {
            "type": "integer"
          },
          "rageCost": {
            "type": "integer"
          },
          "cooldownMs": {
            "type": "integer"
          },
          "aoeRadius": {
            "type": "number"
          },
          "maxRange": {
            "type": "number"
          },
          "power": {
            "type": "integer"
          },
          "statusEffect": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
