{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "biomes"
  ],
  "additionalProperties": false,
  "properties": {
    "biomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "zones",
          "surface",
          "subsurface"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "moistureMin",
                "moistureMax"
              ],
              "additionalProperties": false,
              "properties": {
                "moistureMin": {
                  "type": "number"
                },
                "moistureMax": {
                  "type": "number"
                },
                "altitudeMin": {
                  "type": "integer"
                },
                "altitudeMax": {
                  "type": "integer"
                }
              }
            }
          },
          "surface": {
            "type": "string"
          },
          "subsurface": {
            "type": "string"
          },
          "subsurfaceDepth": {
            "type": "integer"
          },
          "fillers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string"
                },
                "density": {
                  "type": "number"
                }
              }
            }
          },
          "vegetation": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "oak_tree",
                    "pine_tree",
                    "pine_tree_snow",
                    "flower",
                    "weed"
                  ]
                },
                "density": {
                  "type": "number"
                }
              }
            }
          },
          "elevationMin": {
            "type": "integer"
          },
          "elevationMax": {
            "type": "integer"
          },
          "grassColor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ]
          },
          "waterSourceRate": {
            "type": "number"
          },
          "caverns": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cavernMinHeight": {
                    "type": "integer"
                  },
                  "cavernMaxHeight": {
                    "type": "integer"
                  },
                  "stalactitesPresent": {
                    "type": "boolean"
                  },
                  "stalagmitesPresent": {
                    "type": "boolean"
                  },
                  "wallBlock": {
                    "type": "string"
                  },
                  "numberPerVoronoi": {
                    "type": "integer"
                  },
                  "cavernMinRadius": {
                    "type": "integer"
                  },
                  "cavernMaxRadius": {
                    "type": "integer"
                  },
                  "staircaseEnabled": {
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "maxNpcs": {
            "type": "integer"
          }
        }
      }
    },
    "voronoiCellSize": {
      "type": "integer"
    },
    "voronoiBlendRadius": {
      "type": "integer"
    }
  }
}
