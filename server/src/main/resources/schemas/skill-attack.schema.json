{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "damageType": {
      "type": "string",
      "enum": [
        "PHYSICAL",
        "FIRE",
        "POISON",
        "MAGIC",
        "LIGHTNING",
        "NECROTIC"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "levels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "power": {
            "type": "integer"
          },
          "cooldownMs": {
            "type": "integer"
          },
          "manaCost": {
            "type": "integer"
          },
          "rageCost": {
            "type": "integer"
          },
          "rangeOverride": {
            "type": [
              "number",
              "null"
            ]
          },
          "weaponDice": {
            "type": "string"
          },
          "statusEffect": {
            "type": [
              "string",
              "null"
            ]
          },
          "durationSec": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
