{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "defaultGroups": {
      "type": "array",
      "items": {"type": "string"}
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "permissions": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
