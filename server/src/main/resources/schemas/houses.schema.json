{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "gridCellSize": {
      "type": "integer"
    },
    "clusterCheckRadius": {
      "type": "integer"
    },
    "floorHeight": {
      "type": "integer"
    },
    "maxHouseSize": {
      "type": "integer"
    },
    "houseTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "widthMin",
          "widthMax",
          "depthMin",
          "depthMax",
          "floorsMin",
          "floorsMax",
          "roofTypes",
          "roomsMin",
          "roomsMax",
          "doorsMin",
          "doorsMax"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "widthMin": {
            "type": "integer"
          },
          "widthMax": {
            "type": "integer"
          },
          "depthMin": {
            "type": "integer"
          },
          "depthMax": {
            "type": "integer"
          },
          "floorsMin": {
            "type": "integer"
          },
          "floorsMax": {
            "type": "integer"
          },
          "roofTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roomsMin": {
            "type": "integer"
          },
          "roomsMax": {
            "type": "integer"
          },
          "doorsMin": {
            "type": "integer"
          },
          "doorsMax": {
            "type": "integer"
          }
        }
      }
    },
    "defaultBiome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wallBlock": {
          "type": "string"
        },
        "roofBlock": {
          "type": "string"
        },
        "floorBlock": {
          "type": "string"
        },
        "houseProbability": {
          "type": "number"
        },
        "clusterBonus": {
          "type": "number"
        },
        "typeRates": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "biomes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "wallBlock": {
            "type": "string"
          },
          "roofBlock": {
            "type": "string"
          },
          "floorBlock": {
            "type": "string"
          },
          "houseProbability": {
            "type": "number"
          },
          "clusterBonus": {
            "type": "number"
          },
          "typeRates": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
