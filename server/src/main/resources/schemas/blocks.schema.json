{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hardness": {
      "type": "number"
    },
    "solid": {
      "type": "boolean"
    },
    "transparent": {
      "type": "boolean"
    },
    "minimapColor": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3
    },
    "modelElement": {
      "type": "string"
    },
    "gltfModel": {
      "type": "string"
    },
    "liquid": {
      "type": "boolean"
    },
    "viscosity": {
      "type": "integer",
      "minimum": 0
    },
    "replaceable": {
      "type": "boolean"
    },
    "vegetationHost": {
      "type": "boolean"
    },
    "treeAllowed": {
      "type": "boolean"
    },
    "minimapVisible": {
      "type": "boolean"
    },
    "drops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string"
          },
          "dropRate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "minCount": {
            "type": "integer",
            "minimum": 0
          },
          "maxCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "rotatable": {
      "type": "boolean"
    },
    "hasStuds": {
      "type": "boolean"
    },
    "brickSize": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0.5
      },
      "minItems": 3,
      "maxItems": 3
    },
    "plainColorable": {
      "type": "boolean"
    },
    "isCubic": {
      "type": "boolean"
    },
    "rail": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "connections": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "height": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "requiredEquipment": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "enum": [
            "SWORD",
            "LONGSWORD",
            "DAGGER",
            "LONG_DAGGER",
            "DUAL",
            "STAFF",
            "AXE",
            "DOUBLE_AXE",
            "CLUB",
            "BOW",
            "CROSSBOW",
            "HAMMER"
          ]
        }
      ]
    }
  }
}
