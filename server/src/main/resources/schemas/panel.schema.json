{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bbmodelFile": {
      "type": "string"
    },
    "widthBlocks": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "heightBlocks": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "pixelWidth": {
      "type": "integer",
      "minimum": 64
    },
    "pixelHeight": {
      "type": "integer",
      "minimum": 64
    },
    "rotatable": {
      "type": "boolean"
    }
  }
}
