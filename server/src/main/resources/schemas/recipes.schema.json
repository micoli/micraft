{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["giveType", "giveId", "items"],
    "additionalProperties": false,
    "properties": {
      "giveType": {"type": "string", "enum": ["item", "block", "armor"]},
      "giveId": {"type": "string", "minLength": 1},
      "giveAmount": {"type": "integer", "minimum": 1},
      "items": {
        "type": "array",
        "items": {"type": "string", "pattern": "^[A-Z_]+\\*[0-9]+$|^[A-Z_]+$"},
        "minItems": 1
      }
    }
  }
}
