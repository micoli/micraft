  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "allowedClasses": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "WARRIOR",
            "MAGE",
            "RANGER",
            "ROGUE",
            "CLERIC"
          ]
        }
      },
