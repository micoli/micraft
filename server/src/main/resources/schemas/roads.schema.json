{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "vegetationAllowedOnRoad": {
      "type": "boolean"
    },
    "minVegetationDistanceFromRoad": {
      "type": "integer"
    },
    "voronoiCellSize": {
      "type": "integer"
    },
    "displacementScale": {
      "type": "number"
    },
    "displacementFrequency": {
      "type": "number"
    },
    "defaultRoad": {
      "type": "object",
      "required": [
        "width",
        "surface"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer"
        },
        "surface": {
          "type": "string"
        },
        "roadProbability": {
          "type": "number"
        }
      }
    },
    "biomes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "width",
          "surface"
        ],
        "additionalProperties": false,
        "properties": {
          "width": {
            "type": "integer"
          },
          "surface": {
            "type": "string"
          },
          "roadProbability": {
            "type": "number"
          }
        }
      }
    }
  }
}
