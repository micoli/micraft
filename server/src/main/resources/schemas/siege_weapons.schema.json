{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bbmodelFile": {
      "type": "string"
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "projectileType": {
      "type": "string"
    },
    "ammoItem": {
      "type": "string"
    },
    "muzzleOffset": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "launchPower": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "launchPitchDeg": {
      "type": "number"
    },
    "launchPitchDegMin": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "launchPitchDegMax": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "impactRadius": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "impactDamage": {
      "type": "integer",
      "minimum": 0
    },
    "cooldownMs": {
      "type": "integer",
      "minimum": 0
    },
    "pitchStepRange": {
      "type": "integer",
      "minimum": 1
    },
    "powerStepRange": {
      "type": "integer",
      "minimum": 1
    }
  }
}
