{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2019", "DOM"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@plugins/*": ["../../../plugins/*"],
      "@plugins": ["../../../plugins"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
