{
  "name": "mc-bindings",
  "private": true,
  "type": "module",
  "scripts": {
    "gen-plugins": "node scripts/gen-plugins-index.mjs",
    "build": "node scripts/gen-plugins-index.mjs && esbuild index.ts --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --alias:@plugins=../../../plugins $MC_ESBUILD_FLAGS --outfile=${MC_OUT_JS:-../src/wasmJsMain/resources/mc_bindings.js}",
    "build:css": "tailwindcss -i ./styles/main.css -o ${MC_OUT_CSS:-../src/wasmJsMain/resources/main.css} ${MC_TW_FLAGS:---minify}",
    "typecheck": "tsc --noEmit",
    "watch:mc_bindings": "node scripts/gen-plugins-index.mjs && esbuild index.ts --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --alias:@plugins=../../../plugins --outfile=${MC_OUT_JS:-../src/wasmJsMain/resources/mc_bindings.js} --watch=forever",
    "watch:css": "tailwindcss -i ./styles/main.css -o ${MC_OUT_CSS:-../src/wasmJsMain/resources/main.css} --watch=always",
    "build:map": "esbuild map/index.tsx --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --outfile=../../../server/src/main/resources/map.js",
    "watch:map": "esbuild map/index.tsx --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --outfile=../../../server/src/main/resources/map.js --watch=forever",
    "build:map:css": "tailwindcss -i ./styles/main.css -o ../../../server/src/main/resources/map.css",
    "watch:map:css": "tailwindcss -i ./styles/main.css -o ../../../server/src/main/resources/map.css --watch=always",
    "build:admin": "esbuild admin/index.tsx --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --outfile=../../../server/src/main/resources/admin.js",
    "watch:admin": "esbuild admin/index.tsx --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --outfile=../../../server/src/main/resources/admin.js --watch=forever",
    "build:admin:css": "tailwindcss -i ./styles/main.css -o ../../../server/src/main/resources/admin.css",
    "watch:admin:css": "tailwindcss -i ./styles/main.css -o ../../../server/src/main/resources/admin.css --watch=always",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-yaml": "^6.1.3",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "codemirror-json-schema": "^0.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@babylonjs/core": "7.48.0",
    "@eslint/js": "^9.0.0",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.21.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gifenc": "^1.0.3",
    "prettier": "^3.8.4",
    "storybook": "^8.6.12",
    "tailwindcss": "^4.3.2",
    "typescript": "5.4.5",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.3.5"
  }
}
