{
  "name": "mc-bindings",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=10"
  },
  "scripts": {
    "gen-plugins": "node scripts/gen-plugins-index.mjs",
    "copy:babylon": "cp node_modules/babylonjs/babylon.js ${MC_OUT_BABYLON:-../src/wasmJsMain/resources/babylon.js}",
    "copy:babylon-loaders": "cp node_modules/babylonjs-loaders/babylonjs.loaders.js ${MC_OUT_BABYLON_LOADERS:-../src/wasmJsMain/resources/babylonjs.loaders.js}",
    "build": "npm run copy:babylon && npm run copy:babylon-loaders && node scripts/gen-plugins-index.mjs && esbuild index.ts --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --alias:@plugins=../../../plugins $MC_ESBUILD_FLAGS --outfile=${MC_OUT_JS:-../build/web/mc_bindings.js}",
    "build:css": "tailwindcss -i ./styles/main.css -o ${MC_OUT_CSS:-../build/web/main.css} ${MC_TW_FLAGS:---minify}",
    "build:game": "npm run build && npm run build:chunkWorker && npm run build:css",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "watch:mc_bindings": "node scripts/gen-plugins-index.mjs && esbuild index.ts --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --alias:@plugins=../../../plugins --outfile=${MC_OUT_JS:-../build/web/mc_bindings.js} --watch=forever",
    "watch:css": "tailwindcss -i ./styles/main.css -o ${MC_OUT_CSS:-../build/web/main.css} --watch=always",
    "build:map": "esbuild map/index.tsx --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --outfile=${MC_OUT_MAP_JS:-../build/web/map.js}",
    "watch:map": "esbuild map/index.tsx --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --outfile=${MC_OUT_MAP_JS:-../build/web/map.js} --watch=forever",
    "build:map:css": "tailwindcss -i ./styles/main.css -o ${MC_OUT_MAP_CSS:-../build/web/map.css}",
    "watch:map:css": "tailwindcss -i ./styles/main.css -o ${MC_OUT_MAP_CSS:-../build/web/map.css} --watch=always",
    "build:chunkWorker": "esbuild game/lib/chunkMeshWorker.ts --bundle --platform=browser --target=es2017 --format=iife --outfile=${MC_OUT_CHUNK_WORKER_JS:-../build/web/chunk-mesh-worker.js}",
    "watch:chunkWorker": "esbuild game/lib/chunkMeshWorker.ts --bundle --platform=browser --target=es2017 --format=iife --outfile=${MC_OUT_CHUNK_WORKER_JS:-../build/web/chunk-mesh-worker.js} --watch=forever",
    "build:admin": "esbuild admin/index.tsx --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --outfile=${MC_OUT_ADMIN_JS:-../build/web/admin.js}",
    "watch:admin": "esbuild admin/index.tsx --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --outfile=${MC_OUT_ADMIN_JS:-../build/web/admin.js} --watch=forever",
    "build:admin:css": "tailwindcss -i ./styles/main.css -o ${MC_OUT_ADMIN_CSS:-../build/web/admin.css}",
    "watch:admin:css": "tailwindcss -i ./styles/main.css -o ${MC_OUT_ADMIN_CSS:-../build/web/admin.css} --watch=always",
    "build:docs": "esbuild docs/index.tsx --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --outfile=${MC_OUT_DOCS_JS:-../build/web/docs.js}",
    "watch:docs": "esbuild docs/index.tsx --bundle --platform=browser --target=es2017 --format=iife --jsx=automatic --loader:.tsx=tsx --outfile=${MC_OUT_DOCS_JS:-../build/web/docs.js} --watch=forever",
    "gen:api": "openapi-rq -i ../../../server/openapi/openapi.yaml -o ./generated/api --client @hey-api/client-fetch --format prettier",
    "watch:css:sync": "node scripts/watch-css-sync.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006 --no-open",
    "screenshot-stories": "node scripts/screenshot-stories.mjs",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test-storybook": "JEST_CONFIG=test-runner-jest.config.js test-storybook",
    "test-storybook:ci": "kill $(cat /tmp/sb-ci.pid 2>/dev/null) 2>/dev/null; sleep 2; rm -f /tmp/sb-ci.pid; storybook dev -p 9009 --no-open >/dev/null 2>&1 </dev/null & echo $! >/tmp/sb-ci.pid; SB_PID=$!; trap 'kill $SB_PID 2>/dev/null; rm -f /tmp/sb-ci.pid' EXIT INT TERM; node_modules/.bin/wait-on http://127.0.0.1:9009 --timeout 60000 && JEST_CONFIG=test-runner-jest.config.js test-storybook --url http://127.0.0.1:9009"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-yaml": "^6.1.3",
    "@hey-api/client-fetch": "^0.13.1",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tanstack/charts": "^0.12.0",
    "@tanstack/hotkeys": "0.8.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "codemirror-json-schema": "^0.8.1",
    "core-js": "^3.13.1",
    "mobx": "^6.10.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.1",
    "redoc": "^2.5.3",
    "styled-components": "^6.1.13",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@7nohe/openapi-react-query-codegen": "^3.0.2",
    "@babylonjs/core": "7.48.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.61.1",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@storybook/test-runner": "^0.21.3",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.10",
    "babylonjs": "7.48.0",
    "babylonjs-loaders": "9.23.0",
    "esbuild": "0.25.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gifenc": "^1.0.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "storybook": "^8.6.12",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.0"
  },
  "overrides": {
    "uuid": "^11.1.0",
    "js-yaml": "^4.3.1",
    "browserslist": "^4.28.7"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "@swc/core@1.15.43": true,
    "babylonjs@7.48.0": true,
    "babylonjs-loaders@7.48.0": true,
    "core-js@3.50.0": true,
    "esbuild@0.25.12": true
  }
}
